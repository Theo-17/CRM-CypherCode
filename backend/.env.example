PORT=3000

# Conexión a PostgreSQL — cambia los valores por los tuyos
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/NOMBRE_BD?schema=public"

CORS_ORIGIN=http://localhost:3001

# URL del frontend — usada en los links de invitación que se envían por email
FRONTEND_URL=http://localhost:3001

# Clave secreta para JWT (cambia esto por una cadena larga y aleatoria)
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-segura

# Envío real de emails con Resend (obligatorio para invitaciones de usuarios)
# Obtén tu clave gratis en https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Tu CRM <no-reply@tudominio.com>

# PlaceToPay — pasarela de pagos para Ecuador
# Solicita credenciales en placetopay.ec
# PLACETOPAY_URL=https://checkout-test.placetopay.ec
# PLACETOPAY_LOGIN=tu_login
# PLACETOPAY_SECRET_KEY=tu_secret_key

# Google OAuth — Sign-In con Google + integración de Google Calendar
# Crea un cliente OAuth en https://console.cloud.google.com/apis/credentials
# Redirect URIs autorizados:
#   http://localhost:3000/api/auth/google/callback
#   http://localhost:3000/api/google-calendar/callback
BACKEND_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Stripe (opcional, para pagos)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
