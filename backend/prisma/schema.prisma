generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @db.VarChar(255)
  plan_id        String?          @default("gratis") @db.VarChar(50)
  owner_id       String?          @db.Uuid
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  Actividad      Actividad[]
  Automatizacion Automatizacion[]
  Categoria      Categoria[]
  Cliente        Cliente[]
  EmailEnviado   EmailEnviado[]
  Integracion    Integracion[]
  Notificacion   Notificacion[]
  PlantillaEmail PlantillaEmail[]
  Producto       Producto[]
  Seguimiento    Seguimiento[]
  Tarea          Tarea[]
  User           User[]
  Venta          Venta[]
}

model Categoria {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(255)
  descripcion String?
  company_id  String?   @db.Uuid
  created     DateTime? @default(now()) @db.Timestamptz(6)
  updated     DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  Company     Company?  @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Cliente {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id        String?        @db.Uuid
  company_id        String?        @db.Uuid
  nombre            String         @db.VarChar(255)
  email             String?        @db.VarChar(255)
  telefono          String?        @db.VarChar(50)
  empresa           String?        @db.VarChar(255)
  estado            String?        @default("Activo") @db.VarChar(50)
  estado_conversion String?        @default("prospecto") @db.VarChar(50)
  valor_venta       Decimal?       @db.Decimal(10, 2)
  motivo_perdida    String?
  notas             String?
  created           DateTime?      @default(now()) @db.Timestamptz(6)
  updated           DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  Company           Company?       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User              User?          @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  EmailEnviado      EmailEnviado[]
  Seguimiento       Seguimiento[]
  Tarea             Tarea[]
  Venta             Venta[]
}

model Venta {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id   String?     @db.Uuid
  company_id   String?     @db.Uuid
  cliente_id   String?     @db.Uuid
  monto_sin_iva Decimal?   @default(0) @db.Decimal(10, 2)
  iva_monto    Decimal?    @default(0) @db.Decimal(10, 2)
  monto_total  Decimal?    @default(0) @db.Decimal(10, 2)
  estado       String?     @default("completada") @db.VarChar(50)
  fecha        DateTime?   @default(now()) @db.Timestamptz(6)
  created      DateTime?   @default(now()) @db.Timestamptz(6)
  updated      DateTime?   @default(now()) @updatedAt @db.Timestamptz(6)
  ItemVenta    ItemVenta[]
  Cliente      Cliente?    @relation(fields: [cliente_id], references: [id], onUpdate: NoAction)
  Company      Company?    @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User         User?       @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model User {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String           @unique @db.VarChar(255)
  password           String?          @db.VarChar(255)
  name               String?          @db.VarChar(255)
  role               String?          @default("admin") @db.VarChar(50)
  plan               String?          @default("gratis") @db.VarChar(50)
  company_id         String?          @db.Uuid
  invitation_token            String?   @unique @db.VarChar(255)
  invitation_expires          DateTime? @db.Timestamptz(6)
  status                      String?   @default("active") @db.VarChar(20)
  email_verified              Boolean?  @default(true)
  email_verification_token    String?   @unique @db.VarChar(255)
  email_verification_expires  DateTime? @db.Timestamptz(6)
  created            DateTime?        @default(now()) @db.Timestamptz(6)
  updated            DateTime?        @default(now()) @updatedAt @db.Timestamptz(6)
  Actividad          Actividad[]
  Automatizacion     Automatizacion[]
  Cliente            Cliente[]
  EmailEnviado       EmailEnviado[]
  Integracion        Integracion[]
  Notificacion       Notificacion[]
  PlantillaEmail     PlantillaEmail[]
  Producto           Producto[]
  Recordatorio       Recordatorio[]
  Seguimiento        Seguimiento[]
  Tarea              Tarea[]
  Venta              Venta[]
  Company            Company?         @relation(fields: [company_id], references: [id], onUpdate: NoAction)
}

model Actividad {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id   String?   @db.Uuid
  company_id   String?   @db.Uuid
  tipo_entidad String    @db.VarChar(100)
  entidad_id   String    @db.Uuid
  accion       String    @db.VarChar(255)
  descripcion  String?
  created      DateTime? @default(now()) @db.Timestamptz(6)
  updated      DateTime? @default(now()) @db.Timestamptz(6)
  Company      Company?  @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User         User?     @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Automatizacion {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id String?   @db.Uuid
  company_id String?   @db.Uuid
  nombre     String    @db.VarChar(255)
  trigger    String    @db.VarChar(255)
  accion     String    @db.VarChar(255)
  activa     Boolean?  @default(true)
  created    DateTime? @default(now()) @db.Timestamptz(6)
  updated    DateTime? @default(now()) @db.Timestamptz(6)
  Company    Company?  @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User       User?     @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model EmailEnviado {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id     String?         @db.Uuid
  company_id     String?         @db.Uuid
  cliente_id     String?         @db.Uuid
  plantilla_id   String?         @db.Uuid
  fecha_envio    DateTime?       @default(now()) @db.Timestamptz(6)
  asunto         String          @db.VarChar(255)
  cuerpo         String?
  estado         String?         @default("enviado") @db.VarChar(50)
  created        DateTime?       @default(now()) @db.Timestamptz(6)
  updated        DateTime?       @default(now()) @db.Timestamptz(6)
  Cliente        Cliente?        @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Company        Company?        @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  PlantillaEmail PlantillaEmail? @relation(fields: [plantilla_id], references: [id], onUpdate: NoAction)
  User           User?           @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Integracion {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id   String?   @db.Uuid
  company_id   String?   @db.Uuid
  proveedor    String    @db.VarChar(100)
  token_acceso String?
  activa       Boolean?  @default(false)
  created      DateTime? @default(now()) @db.Timestamptz(6)
  updated      DateTime? @default(now()) @db.Timestamptz(6)
  Company      Company?  @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User         User?     @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model InventarioMovimiento {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producto_id String?   @db.Uuid
  cantidad    Int
  tipo        String    @db.VarChar(50)
  motivo      String?   @db.VarChar(255)
  fecha       DateTime? @default(now()) @db.Timestamptz(6)
  created     DateTime? @default(now()) @db.Timestamptz(6)
  updated     DateTime? @default(now()) @db.Timestamptz(6)
  Producto    Producto? @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ItemVenta {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venta_id        String?   @db.Uuid
  producto_id     String?   @db.Uuid
  cantidad        Int
  precio_unitario Decimal   @db.Decimal(10, 2)
  subtotal        Decimal?  @db.Decimal(10, 2)
  created         DateTime? @default(now()) @db.Timestamptz(6)
  updated         DateTime? @default(now()) @db.Timestamptz(6)
  Producto        Producto? @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Venta           Venta?    @relation(fields: [venta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Notificacion {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id String?   @db.Uuid
  company_id String?   @db.Uuid
  tipo       String?   @db.VarChar(100)
  mensaje    String
  leida      Boolean?  @default(false)
  created    DateTime? @default(now()) @db.Timestamptz(6)
  updated    DateTime? @default(now()) @db.Timestamptz(6)
  Company    Company?  @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User       User?     @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model PlantillaEmail {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id   String?        @db.Uuid
  company_id   String?        @db.Uuid
  nombre       String         @db.VarChar(255)
  asunto       String         @db.VarChar(255)
  cuerpo       String
  created      DateTime?      @default(now()) @db.Timestamptz(6)
  updated      DateTime?      @default(now()) @db.Timestamptz(6)
  EmailEnviado EmailEnviado[]
  Company      Company?       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User         User?          @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Producto {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id           String?                @db.Uuid
  company_id           String?                @db.Uuid
  nombre               String                 @db.VarChar(255)
  descripcion          String?
  precio               Decimal?               @default(0) @db.Decimal(10, 2)
  costo                Decimal?               @default(0) @db.Decimal(10, 2)
  stock                Int?                   @default(0)
  sku                  String?                @db.VarChar(100)
  categoria            String?                @db.VarChar(100)
  created              DateTime?              @default(now()) @db.Timestamptz(6)
  updated              DateTime?              @default(now()) @db.Timestamptz(6)
  InventarioMovimiento InventarioMovimiento[]
  ItemVenta            ItemVenta[]
  Company              Company?               @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User                 User?                  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Recordatorio {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id         String?   @db.Uuid
  tarea_id           String?   @db.Uuid
  fecha_recordatorio DateTime  @db.Timestamptz(6)
  enviado            Boolean?  @default(false)
  created            DateTime? @default(now()) @db.Timestamptz(6)
  updated            DateTime? @default(now()) @db.Timestamptz(6)
  Tarea              Tarea?    @relation(fields: [tarea_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User               User?     @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Seguimiento {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id String?   @db.Uuid
  company_id String?   @db.Uuid
  cliente_id String?   @db.Uuid
  tipo       String    @db.VarChar(100)
  fecha      DateTime  @db.Timestamptz(6)
  notas      String?
  created    DateTime? @default(now()) @db.Timestamptz(6)
  updated    DateTime? @default(now()) @db.Timestamptz(6)
  Cliente    Cliente?  @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Company    Company?  @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User       User?     @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Tarea {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id        String?        @db.Uuid
  company_id        String?        @db.Uuid
  cliente_id        String?        @db.Uuid
  titulo            String         @db.VarChar(255)
  descripcion       String?
  estado            String?        @default("Pendiente") @db.VarChar(50)
  prioridad         String?        @default("Media") @db.VarChar(50)
  fecha_vencimiento DateTime?      @db.Timestamptz(6)
  created           DateTime?      @default(now()) @db.Timestamptz(6)
  updated           DateTime?      @default(now()) @db.Timestamptz(6)
  Recordatorio      Recordatorio[]
  Cliente           Cliente?       @relation(fields: [cliente_id], references: [id], onUpdate: NoAction)
  Company           Company?       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User              User?          @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
